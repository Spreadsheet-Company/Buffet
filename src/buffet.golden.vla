(format 17 "2E2645" general nowrap (font 14.85 "F7F4FC"))
(format 18 "2E2645" general nowrap (font 14.85 "C4B0F0"))
(format 19 "2E2645" general nowrap (font bold 14.85 "F7F4FC"))
(format 20 "2E2645" general nowrap (font italic 13.5 "C4B0F0"))
(format 21 "2E2645" general nowrap (font bold 17.55 "C4B0F0"))
(format 24 (font "ADEBB3"))
