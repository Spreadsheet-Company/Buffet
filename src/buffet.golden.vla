(formula "Report" "A11" "=IF(Performance!$B$8=0,\"\",\"Grade: \"&Performance!$B$21&\" for the quarter, and \"&Performance!$C$21&\" for the \"&IF(Performance!$B$9=4,\"year.\",\"year so far.\"))")
