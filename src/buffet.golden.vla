(conditional "Report" 1 "A2" "=Day!$B$19=1" 24)
(formula "Report" "A1" "=\"As of \"&Day!$B$18&\", year \"&Day!$B$6&\", day \"&Day!$B$7&\", \"&Day!$B$16&\" (unaudited)\"")
(value "Report" "A1" "As of Monday, year 1, day 92, 11:10 (unaudited)")
(style "Report" "A1" 18)
(formula "Report" "A2" "=IF(Day!$B$19=1,\"The market is open until 16:00.\",IF(Day!$B$25=1,\"The market opens when you leave the exam room.\",IF(AND(Day!$B$17<Day!$B$12,Day!$B$20<Day!$B$3),\"The market opens at 9:30.\",IF(AND(Day!$B$17<Day!$B$12-1,Day!$B$20=Day!$B$3),\"The market has closed. Analysts are analyzing the aftermath.\",\"The market is closed until Monday at 9:30.\"))))")
(value "Report" "A2" "The market is open until 16:00.")
(style "Report" "A2" 19)
(lit "Report" "A2" 1)
(formula "Report" "A3" "=\"Report card for \"&IF(Proctor!$B$40=0,\"a firm pending registration\",Firms!$E$4)&\", graded by the proctor at seed \"&Clock!$B$3&\" and tier \"&Market!$B$3&\".\"")
(value "Report" "A3" "Report card for Vibes LLC, graded by the proctor at seed 791886 and tier 1.")
(style "Report" "A3" 21)
(formula "Report" "A5" "=IF(Performance!$B$8=0,\"No card yet: the first is issued when the first quarter ends, after its 91st day.\",\"The \"&CHOOSE(Performance!$B$9,\"first\",\"second\",\"third\",\"fourth\")&\" quarter of year \"&Performance!$B$10&\", to its last close.\")")
(value "Report" "A5" "The first quarter of year 1, to its last close.")
(style "Report" "A5" 17)
(cell "Report" "A6" "")
(style "Report" "A6" 6)
(cell "Report" "B6" "Worth ($)")
(style "Report" "B6" 7)
(cell "Report" "C6" "The quarter")
(style "Report" "C6" 7)
(formula "Report" "D6" "=IF(Performance!$B$9=4,\"The year\",\"The year so far\")")
