(window "Report" "A1:E17")
(extent "Report" "A1:E17")
(gridlines "Report" off)
(column "Report" "A" 40.5 shown 16)
(column "Report" "B" 16.2 shown 16)
(column "Report" "C" 16.2 shown 16)
(column "Report" "D" 20.25 shown 16)
(column "Report" "E" 76.95 shown 16)
(row "Report" 4 20.25 shown)
(row "Report" 10 20.25 shown)
(row "Report" 13 20.25 shown)
(row "Report" 15 20.25 shown)
(format 0 none general nowrap)
(format 2 "2E2645" "#,##0.00" nowrap (font 14.85 "F7F4FC"))
(format 4 "2E2645" "+0.00%;-0.00%;+0.00%" nowrap (font 14.85 "F7F4FC"))
(format 6 "3B3159" general nowrap (font bold 14.85 "C4B0F0"))
