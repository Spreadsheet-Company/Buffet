(cell "Performance" "A1" "where a card is shown")
(cell "Performance" "B1" "Report")
(cell "Performance" "A3" "Average Co.'s price now, in cents")
(cell "Performance" "A4" "its shares, bought with the capital at the begin")
(cell "Performance" "A5" "the cents left over, held")
(cell "Performance" "A6" "a quarter's turn")
(cell "Performance" "A7" "a year's turn")
(cell "Performance" "A8" "cards issued")
(cell "Performance" "A9" "the card's quarter, 1 to 4")
(cell "Performance" "A10" "the card's year")
(formula "Performance" "B3" "=Stocks!$E$7")
(formula "Performance" "B4" "=IF(Proctor.last!$B$41<>1,INT(Proctor!$B$39/B3),Performance.last!B4)")
(formula "Performance" "B5" "=IF(Proctor.last!$B$41<>1,Proctor!$B$39-B4*B3,Performance.last!B5)")
(formula "Performance" "B6" "=Day!$B$35")
(formula "Performance" "B7" "=IF(AND(B6=1,Day!$B$33=1),1,0)")
(formula "Performance" "B8" "=Performance.last!B8+$B$6")
(formula "Performance" "B9" "=IF($B$6=1,Day.last!$B$33,Performance.last!B9)")
(formula "Performance" "B10" "=IF($B$6=1,Day.last!$B$6,Performance.last!B10)")
(cell "Performance" "A12" "worth, in cents")
(cell "Performance" "B12" "now")
(cell "Performance" "C12" "at the last card")
(cell "Performance" "D12" "at the one before")
(cell "Performance" "E12" "at the year's start")
(cell "Performance" "F12" "at the last year's")
(cell "Performance" "G12" "at the card's year")
(cell "Performance" "A13" "the firm")
(cell "Performance" "A14" "Average Co., bought and held")
(formula "Performance" "B13" "=Cash!$B$9")
(formula "Performance" "B14" "=$B$4*$B$3+$B$5")
(formula "Performance" "C13:C14" "=IF(OR(Proctor.last!$B$41<>1,$B$6=1),B13,Performance.last!C13)")
(formula "Performance" "D13:D14" "=IF($B$6=1,Performance.last!C13,Performance.last!D13)")
(formula "Performance" "E13:E14" "=IF(OR(Proctor.last!$B$41<>1,$B$7=1),B13,Performance.last!E13)")
(formula "Performance" "F13:F14" "=IF($B$7=1,Performance.last!E13,Performance.last!F13)")
(formula "Performance" "G13:G14" "=IF($B$9=4,F13,E13)")
(cell "Performance" "A16" "the card, in hundredths of a percent")
(cell "Performance" "B16" "the quarter")
(cell "Performance" "C16" "the year so far")
(cell "Performance" "A17" "the firm's return")
(cell "Performance" "A18" "Average Co.'s return")
(cell "Performance" "A19" "alpha, the difference")
(cell "Performance" "A20" "the grade, 1 for A to 5 for F")
(cell "Performance" "A21" "the grade")
(cell "Performance" "A22" "the remark's grade, 1 to 5")
(formula "Performance" "B17:B18" "=IF($B$8=0,\"\",INT(((C13-D13)*20000+D13)/(2*D13)))")
(formula "Performance" "C17:C18" "=IF($B$8=0,\"\",INT(((C13-G13)*20000+G13)/(2*G13)))")
(formula "Performance" "B19:C19" "=IF($B$8=0,\"\",B17-B18)")
(formula "Performance" "B20:C20" "=IF($B$8=0,\"\",IF(B19>=$B$25,1,IF(B19>=$B$26,2,IF(B19>=$B$27,3,IF(B19>=$B$28,4,5)))))")
(formula "Performance" "B21:C21" "=IF($B$8=0,\"\",CHOOSE(B20,$A$25,$A$26,$A$27,$A$28,$A$29))")
(formula "Performance" "B22" "=IF($B$8=0,1,IF($B$9=4,C20,B20))")
(cell "Performance" "A24" "the grades")
(cell "Performance" "B24" "from, in hundredths of a point")
(cell "Performance" "A25" "A")
(cell "Performance" "B25" 200)
(cell "Performance" "A26" "B")
(cell "Performance" "B26" 50)
(cell "Performance" "A27" "C")
(cell "Performance" "B27" -50)
(cell "Performance" "A28" "D")
(cell "Performance" "B28" -200)
(cell "Performance" "A29" "F")
(sheet "Disclosures" hidden)
(column "Disclosures" "A" 100 shown none)
(cell "Disclosures" "A1" "disclosure")
(cell "Disclosures" "C1" "rows")
(cell "Disclosures" "C2" "the row shown")
(cell "Disclosures" "C3" "shown")
(cell "Disclosures" "A2" "Past performance is not indicative of future results, but history has proven (slightly) less coy than the future.")
(cell "Disclosures" "A3" "Buffet is not a financial advisor. Buffet is barely a game.")
(cell "Disclosures" "A4" "All investments carry risk; some investments also carry a reward.")
(cell "Disclosures" "A5" "Buffet is not FDIC-insured. Is the FDIC FDIC-insured? Food for thought.")
(cell "Disclosures" "A6" "Diversification does not ensure a profit; it ensures you will be wrong in several places simultaneously.")
(cell "Disclosures" "A7" "Forward-looking statements are predictions about the future. (see also: divination, prognostication, augury, etc.)")
(cell "Disclosures" "A8" "This is not a recommendation to buy or sell. 'Ursi et tauri, cavete!'.")
(cell "Disclosures" "A9" "Your capital is at risk, but our fees are not.")
(cell "Disclosures" "D1" 8)
(formula "Disclosures" "D3" "=CHOOSE(D2,A2,A3,A4,A5,A6,A7,A8,A9)")
(cell "Disclosures" "C5" "days a disclosure stands")
(cell "Disclosures" "D5" 30)
(formula "Disclosures" "D2" "=MOD(INT(Day!$B$3/D5),D1)+1")
(sheet "Questions" hidden)
(column "Questions" "A" 20 shown none)
(column "Questions" "B" 130 shown none)
(column "Questions" "C" 62 shown none)
(column "Questions" "D" 62 shown none)
(column "Questions" "E" 62 shown none)
(column "Questions" "F" 62 shown none)
(column "Questions" "G" 7 shown none)
(column "Questions" "H" 140 shown none)
(cell "Questions" "A1" "Concept")
(cell "Questions" "B1" "Question")
(cell "Questions" "C1" "Option A")
(cell "Questions" "D1" "Option B")
(cell "Questions" "E1" "Option C")
(cell "Questions" "F1" "Option D")
(cell "Questions" "G1" "Answer")
(cell "Questions" "H1" "Why")
(cell "Questions" "J1" "rows")
(cell "Questions" "J2" "the row shown")
(cell "Questions" "J3" "shown")
(cell "Questions" "J4" "Question")
(cell "Questions" "J5" "Option A")
(cell "Questions" "J6" "Option B")
(cell "Questions" "J7" "Option C")
(cell "Questions" "J8" "Option D")
(cell "Questions" "J9" "Answer")
(cell "Questions" "J10" "Why")
(cell "Questions" "A2" "Opportunity Cost")
(cell "Questions" "B2" "You can read a prospectus or take a nap. The opportunity cost of the nap is:")
(cell "Questions" "C2" "nothing, naps are free")
(cell "Questions" "D2" "the prospectus, and probably a lawsuit")
(cell "Questions" "E2" "the value of the best thing you gave up")
(cell "Questions" "F2" "$4.99 a month (billed annually)")
(cell "Questions" "G2" "C")
(cell "Questions" "H2" "Every choice you make costs the value of the best alternative you gave up, whether or not anyone sends an invoice.")
(cell "Questions" "A3" "Supply and Demand")
(cell "Questions" "B3" "It is raining and umbrella prices increase. This is:")
(cell "Questions" "C3" "a conspiracy by Big Umbrella")
(cell "Questions" "D3" "demand rising against a fixed supply")
(cell "Questions" "E3" "a scalper's dream")
(cell "Questions" "F3" "illegal in at least one state")
(cell "Questions" "G3" "B")
(cell "Questions" "H3" "When more people want a thing than are available, its price rises until enough interested buyers stop wanting it at the new price.")
(cell "Questions" "A4" "Inflation")
(cell "Questions" "B4" "Your cash earns 0% while prices rise 3% a year. After a year it buys:")
(cell "Questions" "C4" "the same; a dollar is a dollar")
(cell "Questions" "D4" "nothing; it has gone to a better place")
(cell "Questions" "E4" "about 3% less")
(cell "Questions" "F4" "more (if you think positively)")
(cell "Questions" "G4" "C")
(cell "Questions" "H4" "Rising prices shrink what idle cash buys: at 3% inflation, a dollar earning nothing buys about 3% less each year.")
(cell "Questions" "A5" "The Rule of 72")
(cell "Questions" "B5" "At an 8% growth rate every year, your money would roughly double in:")
(cell "Questions" "C5" "9 years")
(cell "Questions" "D5" "8 years, because 8")
(cell "Questions" "E5" "never; money only grows on trees")
(cell "Questions" "F5" "one quarter, according to an ad I saw in a magazine")
(cell "Questions" "G5" "A")
(cell "Questions" "H5" "Divide 72 by the yearly rate in percent to calculate the number of years money takes to double: 72 over 8 is 9, give or take a few days.")
(cell "Questions" "A6" "Risk and Return")
(cell "Questions" "B6" "On average, the higher the expected return, the:")
(cell "Questions" "C6" "higher the risk, which is what you are being compensated for")
(cell "Questions" "D6" "lower the risk, obviously")
(cell "Questions" "E6" "better the logo")
(cell "Questions" "F6" "closer your brother-in-law is to being right")
(cell "Questions" "G6" "A")
(cell "Questions" "H6" "Investors demand a higher expected return for bearing more risk, so an offer of high return and low risk is usually missing one of the two.")
(cell "Questions" "A7" "Diversification")
(cell "Questions" "B7" "'Don't put all your eggs in one basket' is advice about:")
(cell "Questions" "C7" "husbandry")
(cell "Questions" "D7" "basket-weaving")
(cell "Questions" "E7" "spreading risk without necessarily lowering expected return")
(cell "Questions" "F7" "omelettes")
(cell "Questions" "G7" "C")
(cell "Questions" "H7" "Owning things that do not all fall at once can lower the risk of the whole without lowering its expected return, a rare bargain.")
(cell "Questions" "A8" "Bonds")
(cell "Questions" "B8" "A bond is:")
(cell "Questions" "C8" "a lasting emotional connection between you and a company")
(cell "Questions" "D8" "an international spy")
(cell "Questions" "E8" "a stock with a sad backstory")
(cell "Questions" "F8" "a loan, with interest payments until it matures and the principal is repaid")
(cell "Questions" "G8" "D")
(cell "Questions" "H8" "A bond is a loan: the borrower pays you interest on a schedule and repays the principal when it matures, barring the unforeseen.")
(cell "Questions" "A9" "Interest Rates")
(cell "Questions" "B9" "When interest rates rise, existing bonds:")
(cell "Questions" "C9" "fall in price, because new bonds pay higher interest rates")
(cell "Questions" "D9" "rise, out of solidarity")
(cell "Questions" "E9" "stay the same, because bonds are fixed-rate investments")
(cell "Questions" "F9" "are not discussed at parties")
(cell "Questions" "G9" "A")
(cell "Questions" "H9" "When new bonds pay more, an old bond's fixed interest is worth less, so its price falls until it yields what the new ones do.")
(cell "Questions" "A10" "Liquidity")
(cell "Questions" "B10" "Which asset is the most liquid?")
(cell "Questions" "C10" "a private island")
(cell "Questions" "D10" "a 1952 baseball card")
(cell "Questions" "E10" "your cousin's startup")
(cell "Questions" "F10" "cash")
(cell "Questions" "G10" "D")
(cell "Questions" "H10" "Liquidity is how quickly something turns into cash without a discount, and cash, conveniently, already is.")
(cell "Questions" "A11" "Bear Market")
(cell "Questions" "B11" "A bear market is a fall of at least:")
(cell "Questions" "C11" "2%, and a deep sigh")
(cell "Questions" "D11" "20% from the peak")
(cell "Questions" "E11" "100%, a figure usually reserved for your cousin's startup")
(cell "Questions" "F11" "a bear's weight in honey")
(cell "Questions" "G11" "B")
(cell "Questions" "H11" "By convention, a fall of 20% from a peak is a bear market, a fall of 10% a correction, and a fall of 2% a Tuesday.")
(cell "Questions" "A12" "Price-to-Earnings Ratio")
(cell "Questions" "B12" "A stock with a price-to-earnings (P/E) ratio of 20 costs, per dollar of annual earnings:")
(cell "Questions" "C12" "$0.05")
(cell "Questions" "D12" "20 hugs")
(cell "Questions" "E12" "a bargain, according to the company")
(cell "Questions" "F12" "$20")
(cell "Questions" "G12" "D")
(cell "Questions" "H12" "A price-to-earnings ratio of 20 means a share costs 20 times its yearly earnings: $20 for each dollar it earns in a year.")
(cell "Questions" "A13" "Moral Hazard")
(cell "Questions" "B13" "Adopting a 'too big to fail' mindset encourages banks to:")
(cell "Questions" "C13" "shrink")
(cell "Questions" "D13" "take more risk, because someone else pays for the downside")
(cell "Questions" "E13" "take up skydiving as a hobby")
(cell "Questions" "F13" "fail bigger, for the publicity")
(cell "Questions" "G13" "B")
(cell "Questions" "H13" "When someone else will cover the losses, risk-taking grows; economists call this moral hazard, and banks call it a business model.")
(cell "Questions" "A14" "Leverage")
(cell "Questions" "B14" "You put in $1, borrow $9 and buy a $10 asset that falls 10%. Your equity is now:")
(cell "Questions" "C14" "$9")
(cell "Questions" "D14" "$10")
(cell "Questions" "E14" "$0")
(cell "Questions" "F14" "a learning experience")
(cell "Questions" "G14" "C")
(cell "Questions" "H14" "Borrowing magnifies gains and losses alike: at ten times leverage, a 10% fall takes everything you put in.")
(cell "Questions" "A15" "Sunk Costs")
(cell "Questions" "B15" "You paid $50 for a terrible movie and stay 'because you paid'. This is:")
(cell "Questions" "C15" "the sunk-cost fallacy")
(cell "Questions" "D15" "loyalty")
(cell "Questions" "E15" "cinema")
(cell "Questions" "F15" "a deductible")
(cell "Questions" "G15" "A")
(cell "Questions" "H15" "Money already spent is gone whatever you do next, so it should have no say in what you do next.")
(cell "Questions" "A16" "Deposit Insurance")
(cell "Questions" "B16" "A US bank deposit is insured by the FDIC, per depositor, per insured bank, up to:")
(cell "Questions" "C16" "$2.50")
(cell "Questions" "D16" "$250,000")
(cell "Questions" "E16" "$250 million")
(cell "Questions" "F16" "infinity, because the FDIC is a government agency")
(cell "Questions" "G16" "B")
(cell "Questions" "H16" "The FDIC insures deposits up to $250,000 per depositor, per insured bank, for each ownership category; the cautious use more than one bank.")
(cell "Questions" "A17" "Central Banks")
(cell "Questions" "B17" "A central bank raises rates to:")
(cell "Questions" "C17" "make borrowing cheaper")
(cell "Questions" "D17" "impress other central banks")
(cell "Questions" "E17" "give the bond market something to talk about")
(cell "Questions" "F17" "combat inflation by making borrowing more expensive")
(cell "Questions" "G17" "D")
(cell "Questions" "H17" "Higher rates make borrowing cost more, so people and firms borrow and spend less, and prices rise more slowly, eventually.")
(cell "Questions" "A18" "Efficient Markets")
(cell "Questions" "B18" "Two economists see a $20 bill on the sidewalk. One says, 'If it were real, someone would have picked it up.' This is a joke about:")
(cell "Questions" "C18" "the efficient-market hypothesis")
(cell "Questions" "D18" "littering")
(cell "Questions" "E18" "sidewalks")
(cell "Questions" "F18" "hallucinations")
(cell "Questions" "G18" "A")
(cell "Questions" "H18" "If prices already reflect what is known, beating the market takes knowing what others do not, which is rarer than it feels.")
(cell "Questions" "A19" "Time Value of Money")
(cell "Questions" "B19" "Would you rather receive $100 today or $100 in a year from now?")
(cell "Questions" "C19" "in a year, because I like to plan ahead")
(cell "Questions" "D19" "in a year, because I left my wallet at home")
(cell "Questions" "E19" "today, because it can earn something meanwhile")
(cell "Questions" "F19" "neither, because cash is dead")
(cell "Questions" "G19" "C")
(cell "Questions" "H19" "A dollar today can be invested to become more than a dollar by next year, so a dollar promised later is worth less than one now.")
(cell "Questions" "A20" "Short Selling")
(cell "Questions" "B20" "You short a stock at $10 and it goes to $20. Your loss is:")
(cell "Questions" "C20" "$0; you never owned it in the first place")
(cell "Questions" "D20" "$10 a share, and it can keep growing")
(cell "Questions" "E20" "capped at $10")
(cell "Questions" "F20" "spiritual")
(cell "Questions" "G20" "B")
(cell "Questions" "H20" "A short seller sells borrowed shares and must buy them back at whatever the price becomes, and a price has no ceiling.")
(cell "Questions" "A21" "Shares")
(cell "Questions" "B21" "A share of a company's stock is:")
(cell "Questions" "C21" "a loan you make to the company")
(cell "Questions" "D21" "a voucher for the company's products")
(cell "Questions" "E21" "a stock photo of the company's executives shaking hands")
(cell "Questions" "F21" "a small piece of the company, with a claim on its profits and usually a vote at its meetings")
(cell "Questions" "G21" "D")
(cell "Questions" "H21" "A share is a small piece of a company: a claim on its profits and usually a vote at its meetings, though seldom a parking space.")
(cell "Questions" "K1" 20)
(formula "Questions" "K3" "=CHOOSE(K2,A2,A3,A4,A5,A6,A7,A8,A9,A10,A11,A12,A13,A14,A15,A16,A17,A18,A19,A20,A21)")
(formula "Questions" "K4" "=CHOOSE(K2,B2,B3,B4,B5,B6,B7,B8,B9,B10,B11,B12,B13,B14,B15,B16,B17,B18,B19,B20,B21)")
(formula "Questions" "K5" "=CHOOSE(K2,C2,C3,C4,C5,C6,C7,C8,C9,C10,C11,C12,C13,C14,C15,C16,C17,C18,C19,C20,C21)")
(formula "Questions" "K6" "=CHOOSE(K2,D2,D3,D4,D5,D6,D7,D8,D9,D10,D11,D12,D13,D14,D15,D16,D17,D18,D19,D20,D21)")
(formula "Questions" "K7" "=CHOOSE(K2,E2,E3,E4,E5,E6,E7,E8,E9,E10,E11,E12,E13,E14,E15,E16,E17,E18,E19,E20,E21)")
(formula "Questions" "K8" "=CHOOSE(K2,F2,F3,F4,F5,F6,F7,F8,F9,F10,F11,F12,F13,F14,F15,F16,F17,F18,F19,F20,F21)")
(formula "Questions" "K9" "=CHOOSE(K2,G2,G3,G4,G5,G6,G7,G8,G9,G10,G11,G12,G13,G14,G15,G16,G17,G18,G19,G20,G21)")
(formula "Questions" "K10" "=CHOOSE(K2,H2,H3,H4,H5,H6,H7,H8,H9,H10,H11,H12,H13,H14,H15,H16,H17,H18,H19,H20,H21)")
(formula "Questions" "K2" "=Proctor!$B$34")
