(formula "Commands" "B7" "=\"Buy 10 shares of \"&Orders!$B$17")
(formula "Commands" "B8" "=\"Buy as many shares of \"&Orders!$B$17&\" as the cash covers\"")
(formula "Commands" "B9" "=\"Sell 1 share of \"&Orders!$B$17")
(formula "Commands" "B10" "=\"Sell 10 shares of \"&Orders!$B$17")
(formula "Commands" "B11" "=\"Sell every share of \"&Orders!$B$17")
(formula "Commands" "C2:C11" "=Input!$B$19=Orders!$B$2")
(sheet "Write" visible)
(cell "Write" "A1" "sheet")
(cell "Write" "B1" "address")
(cell "Write" "C1" "value")
(cell "Write" "A2" "Ledger")
(formula "Write" "B2" "=IF(Orders!$B$26<>0,\"A\"&Orders!$B$30,\"\")")
(formula "Write" "C2" "=Orders!$B$29")
(cell "Write" "A3" "Ledger")
(formula "Write" "B3" "=IF(Orders!$B$26<>0,\"B\"&Orders!$B$30,\"\")")
(formula "Write" "C3" "=Day.last!$B$18&\", year \"&Day.last!$B$6&\", day \"&Day.last!$B$7&\", \"&Day.last!$B$16")
(cell "Write" "A4" "Ledger")
(formula "Write" "B4" "=IF(Orders!$B$26<>0,\"C\"&Orders!$B$30,\"\")")
(formula "Write" "C4" "=IF(Orders!$B$19=2,\"Personal\",\"Firm\")")
(cell "Write" "A5" "Ledger")
(formula "Write" "B5" "=IF(Orders!$B$26<>0,\"D\"&Orders!$B$30,\"\")")
(formula "Write" "C5" "=Orders!$B$18")
(cell "Write" "A6" "Ledger")
(formula "Write" "B6" "=IF(Orders!$B$26<>0,\"E\"&Orders!$B$30,\"\")")
(formula "Write" "C6" "=Orders!$B$26")
(cell "Write" "A7" "Ledger")
(formula "Write" "B7" "=IF(Orders!$B$26<>0,\"F\"&Orders!$B$30,\"\")")
(formula "Write" "C7" "=Orders!$B$23")
(cell "Write" "A8" "Ledger")
(formula "Write" "B8" "=IF(Orders!$B$26<>0,\"G\"&Orders!$B$30,\"\")")
(formula "Write" "C8" "=Orders!$B$31")
