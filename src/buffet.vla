(cartridge "buffet"
  (spec 3)
  (title "Buffet")
  (rate 30)
  (screen grid 80 50)
  (seed 791886)
  (author "Spreadsheet Company")
  (license "AGPL-3.0-or-later AND CC-BY-SA-4.0")
  (notes "Buffet: All You Can Sheet. The back office is open and the front office is not: so far the market's calendar, a market day a second; its dice, rolled once a day where anyone can watch them roll; the market itself, four waves and a drift, moving once a day; four stocks priced off it in whole cents, the dearest paying a dividend four days a year; and the fine print, a disclosure a month. Pick the Day, the Dice, the Market or the Stocks sheet to watch, or the Disclosures sheet among the hidden sheets."))
(sheet "Screen" visible)
(sheet "Day" visible)
(sheet "Dice" visible)
(sheet "Market" visible)
(sheet "Stocks" visible)
(cell "Day" "A1" "frames a day")
(cell "Day" "A2" "days a year")
(cell "Day" "A3" "day")
(cell "Day" "A4" "phase")
(cell "Day" "A5" "boundary")
(cell "Day" "A6" "year")
(cell "Day" "A7" "day of the year")
(cell "Day" "B1" 30)
(cell "Day" "B2" 365)
(formula "Day" "B3" "=INT((Clock!B1-1)/B1)")
(formula "Day" "B4" "=MOD(Clock!B1-1,B1)")
(formula "Day" "B5" "=IF(B4=0,1,0)")
(formula "Day" "B6" "=INT(B3/B2)+1")
(formula "Day" "B7" "=MOD(B3,B2)+1")
(cell "Dice" "A1" "the market's die")
