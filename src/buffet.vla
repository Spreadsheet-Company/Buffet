(column "Exam" "A" 100 shown none)
(formula "Exam" "A1" "=\"As of \"&Day!$B$18&\", year \"&Day!$B$6&\", day \"&Day!$B$7&\", \"&Day!$B$16&\" (unaudited)\"")
(formula "Exam" "A2" "=IF(Day!$B$19=1,\"The market is open until 16:00.\",IF(Day!$B$25=1,\"The market opens when you leave the exam room.\",IF(AND(Day!$B$17<Day!$B$12,Day!$B$20<Day!$B$3),\"The market opens at 9:30.\",IF(AND(Day!$B$17<Day!$B$12-1,Day!$B$20=Day!$B$3),\"The market has closed. Analysts are analyzing the aftermath.\",\"The market is closed until Monday at 9:30.\"))))")
(formula "Exam" "A3" "=IF(Proctor!$B$33=1,IF(Proctor!$B$32<10,\"The Series 777, question \"&(Proctor!$B$32+1)&\" of 11. Correct answers earn starting capital.\",\"The Series 777, question 11 of 11, ungraded: it names your firm.\"),IF(Proctor!$B$3=1,\"The Series 777: waived.\",\"Pencils down. Your certificate is on its sheet.\"))")
(formula "Exam" "A5" "=IF(Proctor!$B$33=0,\"\",IF(Proctor!$B$32<10,Questions!$K$4,\"Which best describes you?\"))")
(formula "Exam" "A7:A10" "=IF(Proctor!$B$33=0,\"\",IF(Proctor!$B$32<10,\"[ \"&Proctor!A24&\" ]  \"&Questions!K5,\"[ \"&Proctor!A24&\" ]  \"&Firms!A2))")
(formula "Exam" "A12" "=IF(Proctor!$B$33=1,\"Click an answer, or press its letter: A, B, C or D.\",\"\")")
(style "Exam" "A7:A10" 11)
(look "Exam" "" 0)
(formula "Exam" "A14" "=Disclosures!$D$3")
(column "Certificate" "A" 21 shown none)
(column "Certificate" "B" 12 shown none)
(formula "Certificate" "A1" "=\"As of \"&Day!$B$18&\", year \"&Day!$B$6&\", day \"&Day!$B$7&\", \"&Day!$B$16&\" (unaudited)\"")
(formula "Certificate" "A2" "=IF(Day!$B$19=1,\"The market is open until 16:00.\",IF(Day!$B$25=1,\"The market opens when you leave the exam room.\",IF(AND(Day!$B$17<Day!$B$12,Day!$B$20<Day!$B$3),\"The market opens at 9:30.\",IF(AND(Day!$B$17<Day!$B$12-1,Day!$B$20=Day!$B$3),\"The market has closed. Analysts are analyzing the aftermath.\",\"The market is closed until Monday at 9:30.\"))))")
