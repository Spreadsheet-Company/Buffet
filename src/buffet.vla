(formula "Questions" "K10" "=CHOOSE(K2,H2,H3,H4,H5,H6,H7,H8,H9,H10,H11,H12,H13,H14,H15,H16,H17,H18,H19,H20,H21)")
(formula "Questions" "K2" "=Proctor!$B$34")
(sheet "Firms" hidden)
(column "Firms" "A" 40 shown none)
(cell "Firms" "A1" "Style")
(cell "Firms" "C1" "rows")
(cell "Firms" "C2" "the row shown")
(cell "Firms" "C3" "shown")
(cell "Firms" "A2" "I read the prospectus")
(cell "Firms" "A3" "I read the headlines")
(cell "Firms" "A4" "I read the room")
(cell "Firms" "A5" "I feel the market")
(cell "Firms" "D1" 4)
(formula "Firms" "D3" "=CHOOSE(D2,A2,A3,A4,A5)")
(formula "Firms" "D2" "=MAX(Proctor!$B$40,1)")
(sheet "Caveats" visible)
(column "Caveats" "A" 104 shown none)
(column "Caveats" "B" 115 shown none)
(column "Caveats" "C" 103 shown none)
(column "Caveats" "D" 15 shown none)
(cell "Caveats" "A1" "Things this game gets wrong")
(cell "Caveats" "B1" "In the real world")
(cell "Caveats" "C1" "Management's response")
(cell "Caveats" "D1" "Where")
(cell "Caveats" "F1" "rows")
(cell "Caveats" "F2" "the row shown")
(cell "Caveats" "F3" "shown")
(cell "Caveats" "F4" "In the real world")
(cell "Caveats" "F5" "Management's response")
(cell "Caveats" "F6" "Where")
(cell "Caveats" "A2" "You. It knows nothing of your goals, your means or your timeline.")
(cell "Caveats" "B2" "Advice starts from those three, from someone licensed to give it. This game is not financial advice.")
(cell "Caveats" "C2" "Any resemblance to financial advice, living or dead, is purely coincidental.")
(cell "Caveats" "D2" "")
(cell "Caveats" "A3" "The market keeps no holidays: every weekday trades, 261 sessions in the first year.")
(cell "Caveats" "B3" "US exchanges also close for about ten holidays a year, leaving about 252 trading days.")
(cell "Caveats" "C3" "Holidays are available from the rank of Partner.")
(cell "Caveats" "D3" "Day!B12")
(cell "Caveats" "A4" "Tomorrow's price is a formula of the seed and the day, and anyone can read it.")
(cell "Caveats" "B4" "No one knows tomorrow's price, and anyone who says otherwise is selling something.")
(cell "Caveats" "C4" "Reading ahead is not insider trading, since everyone can. Compliance finds this unsettling.")
(cell "Caveats" "D4" "Market!B25")
(cell "Caveats" "A5" "The market is four waves and a drift, and each wave keeps its period to the day.")
(cell "Caveats" "B5" "Real business cycles vary in length and depth, and economists still argue whether the longest ones exist at all.")
(cell "Caveats" "C5" "The Kondratiev wave is fitted to a handful of 50-year cycles. Statistics has requested a larger sample.")
(cell "Caveats" "D5" "Market!A8:E11")
(cell "Caveats" "A6" "Day to day, the market barely moves: no news, no noise, no crash.")
(cell "Caveats" "B6" "A broad index can move 1% on an ordinary day, and on October 19, 1987, US stocks fell more than 20%.")
(cell "Caveats" "C6" "Trading in news has been halted, pending an announcement.")
(cell "Caveats" "D6" "Market!B25")
(cell "Caveats" "A7" "Beneath the waves, the market grows 7.6% a year, every year, forever.")
(cell "Caveats" "B7" "US stocks have returned about 10% a year over a century, dividends included, but unevenly: 2000 to 2009 lost money.")
(cell "Caveats" "C7" "Here, past performance is indicative of future results. Management asks that this not get around.")
(cell "Caveats" "D7" "Market!B2")
(cell "Caveats" "A8" "All four stocks follow the one index: none can go bust, and owning all four spreads no risk.")
(cell "Caveats" "B8" "Each company has news of its own; owning many cancels much of it, and some companies do go to zero.")
(cell "Caveats" "C8" "Management is pleased to report a 0% default rate, and is investigating why.")
(cell "Caveats" "D8" "Stocks!E5:E8")
(cell "Caveats" "A9" "The riskier the stock, the faster it grows: a beta of 2 trends 15.7% a year, a beta of 0.75 trends 5.6%.")
(cell "Caveats" "B9" "Riskier stocks have not reliably earned more: over long stretches, low-volatility stocks did as well or better.")
(cell "Caveats" "C9" "Management has decided that risk will be rewarded, and has asked the data to comply.")
(cell "Caveats" "D9" "Stocks!C5:C8")
(cell "Caveats" "A10" "The dividend is free: a share's price does not fall on the day it pays.")
(cell "Caveats" "B10" "A share's price usually falls by about the dividend on the day it goes ex, since that cash has left the company.")
(cell "Caveats" "C10" "Accounting has been asked not to look into it.")
(cell "Caveats" "D10" "Stocks!H8")
(cell "Caveats" "A11" "Money comes in whole cents: every price is rounded once, to the nearest cent.")
(cell "Caveats" "B11" "Ledgers keep fractions of a cent: interest accrues in them daily, and the rounding comes last.")
(cell "Caveats" "C11" "Fractions of a cent are swept into an account named 'Rounding (do not open)'.")
(cell "Caveats" "D11" "Stocks!E5:F8")
(cell "Caveats" "A12" "A $1 share moves a penny at a time, and most days closes where it opened.")
(cell "Caveats" "B12" "A real stock near $1 can swing several percent a day, and under $1 it may be quoted to a hundredth of a cent.")
(cell "Caveats" "C12" "Analysts rate it a Hold, which it does.")
(cell "Caveats" "D12" "Stocks!E5")
(cell "Caveats" "A13" "Numbers have no formats: $12.30 is 1230 in the model's cents and text on the Portfolio; 2% reads 0.02.")
(cell "Caveats" "B13" "A workbook formats its numbers for people: $12.30, 2.00%, 1,000,000.")
(cell "Caveats" "C13" "The decimal point has returned from furlough, on a text-only contract.")
(cell "Caveats" "D13" "Portfolio!B5:C8")
(cell "Caveats" "A14" "Prices move on the half hour and stand still between.")
(cell "Caveats" "B14" "A share's price moves with every trade, many times a second, from the opening bell to the closing one.")
(cell "Caveats" "C14" "Management prefers prices that keep to a timetable.")
(cell "Caveats" "D14" "Day!B22")
(cell "Caveats" "A15" "Each day's close is decided before the bell: the half hours wander off it and always come back.")
(cell "Caveats" "B15" "Nobody knows a day's close before the closing bell, which is the point of having one.")
(cell "Caveats" "C15" "Management confirms the close was agreed in advance, as a courtesy to the auditors.")
(cell "Caveats" "D15" "Market!B45")
(cell "Caveats" "A16" "The Series 777 cannot be failed, and ten questions license you to manage other people's money.")
(cell "Caveats" "B16" "FINRA's qualification exams can be failed: the Series 7 asks 125 scored questions and passes at 72%.")
(cell "Caveats" "C16" "Management passed the Series 777 on its first attempt, as everyone does.")
(cell "Caveats" "D16" "Proctor!B38")
(cell "Caveats" "A17" "The market waits at its opening bell until you leave the exam room.")
(cell "Caveats" "B17" "The opening bell rings at 9:30 whether or not anyone has finished an exam.")
(cell "Caveats" "C17" "Management asked the exchange to hold the bell. The exchange agreed, this once.")
(cell "Caveats" "D17" "Day!B26")
(cell "Caveats" "A18" "An order fills whole at the price shown, at once, with no spread, no commission and no day to settle.")
(cell "Caveats" "B18" "A buyer pays the ask and a seller gets the bid, a broker may charge, and a trade settles a business day later.")
(cell "Caveats" "C18" "Our broker works for exposure.")
(cell "Caveats" "D18" "Orders!B23")
(cell "Caveats" "G1" 17)
(formula "Caveats" "G3" "=CHOOSE(G2,A2,A3,A4,A5,A6,A7,A8,A9,A10,A11,A12,A13,A14,A15,A16,A17,A18)")
(formula "Caveats" "G4" "=CHOOSE(G2,B2,B3,B4,B5,B6,B7,B8,B9,B10,B11,B12,B13,B14,B15,B16,B17,B18)")
(formula "Caveats" "G5" "=CHOOSE(G2,C2,C3,C4,C5,C6,C7,C8,C9,C10,C11,C12,C13,C14,C15,C16,C17,C18)")
(formula "Caveats" "G6" "=CHOOSE(G2,D2,D3,D4,D5,D6,D7,D8,D9,D10,D11,D12,D13,D14,D15,D16,D17,D18)")
(column "Caveats" "F" 21 shown none)
(cell "Caveats" "G2" 1)
(format 1 "A080E0" general nowrap)
(column "Exam" "A" 100 shown none)
(formula "Exam" "A1" "=\"As of \"&Day!$B$18&\", year \"&Day!$B$6&\", day \"&Day!$B$7&\", \"&Day!$B$16&\" (unaudited)\"")
(formula "Exam" "A2" "=IF(Day!$B$19=1,\"The market is open until 16:00.\",IF(Day!$B$25=1,\"The market opens when you leave the exam room.\",IF(AND(Day!$B$17<Day!$B$12,Day!$B$20<Day!$B$3),\"The market opens at 9:30.\",IF(AND(Day!$B$17<Day!$B$12-1,Day!$B$20=Day!$B$3),\"The market has closed. Analysts are analyzing the aftermath.\",\"The market is closed until Monday at 9:30.\"))))")
(formula "Exam" "A3" "=IF(Proctor!$B$33=1,IF(Proctor!$B$32<10,\"The Series 777, question \"&(Proctor!$B$32+1)&\" of 11. Correct answers earn starting capital.\",\"The Series 777, question 11 of 11, ungraded: it sets your firm's style.\"),IF(Proctor!$B$3=1,\"The Series 777: waived.\",\"Pencils down. Your certificate is on its sheet.\"))")
(formula "Exam" "A5" "=IF(Proctor!$B$33=0,\"\",IF(Proctor!$B$32<10,Questions!$K$4,\"Which best describes you?\"))")
(formula "Exam" "A7:A10" "=IF(Proctor!$B$33=0,\"\",IF(Proctor!$B$32<10,\"[ \"&Proctor!A24&\" ]  \"&Questions!K5,\"[ \"&Proctor!A24&\" ]  \"&Firms!A2))")
(formula "Exam" "A12" "=IF(Proctor!$B$33=1,\"Click an answer, or press its letter: A, B, C or D.\",\"\")")
(style "Exam" "A7" 1)
(style "Exam" "A8" 1)
(style "Exam" "A9" 1)
(style "Exam" "A10" 1)
(look "Exam" "" 0)
(formula "Exam" "A14" "=Disclosures!$D$3")
(column "Certificate" "A" 21 shown none)
(column "Certificate" "B" 12 shown none)
(formula "Certificate" "A1" "=\"As of \"&Day!$B$18&\", year \"&Day!$B$6&\", day \"&Day!$B$7&\", \"&Day!$B$16&\" (unaudited)\"")
(formula "Certificate" "A2" "=IF(Day!$B$19=1,\"The market is open until 16:00.\",IF(Day!$B$25=1,\"The market opens when you leave the exam room.\",IF(AND(Day!$B$17<Day!$B$12,Day!$B$20<Day!$B$3),\"The market opens at 9:30.\",IF(AND(Day!$B$17<Day!$B$12-1,Day!$B$20=Day!$B$3),\"The market has closed. Analysts are analyzing the aftermath.\",\"The market is closed until Monday at 9:30.\"))))")
(cell "Certificate" "A3" "The Series 777: a certificate of completion")
(formula "Certificate" "A5" "=IF(Proctor!$B$33=1,\"Pending: the proctor certifies after the eleventh question.\",IF(Proctor!$B$3=1,\"Waived: the regulator assumes you would have passed.\",\"The bearer has sat the Series 777 and passed, as every candidate does.\"))")
(cell "Certificate" "A7" "Correct answers")
(cell "Certificate" "A8" "Firm capital ($)")
(cell "Certificate" "A9" "Style")
(formula "Certificate" "B7" "=Proctor!$B$38&\" of 10\"")
(formula "Certificate" "B8" "=IF(Proctor!B39<1000,\"              \",IF(Proctor!B39<10000,\"            \",IF(Proctor!B39<100000,\"          \",IF(Proctor!B39<1000000,\"       \",IF(Proctor!B39<10000000,\"     \",IF(Proctor!B39<100000000,\"   \",\"\"))))))&IF(Proctor!B39<100000,INT(Proctor!B39/100),IF(Proctor!B39<100000000,INT(Proctor!B39/100000),IF(Proctor!B39<100000000000,INT(Proctor!B39/100000000),IF(Proctor!B39<100000000000000,INT(Proctor!B39/100000000000),INT(Proctor!B39/100000000000000))))&IF(Proctor!B39>=100000000000000,\",\"&MOD(INT(INT(Proctor!B39/100)/100000000000),10)&MOD(INT(INT(Proctor!B39/100)/10000000000),10)&MOD(INT(INT(Proctor!B39/100)/1000000000),10),\"\")&IF(Proctor!B39>=100000000000,\",\"&MOD(INT(INT(Proctor!B39/100)/100000000),10)&MOD(INT(INT(Proctor!B39/100)/10000000),10)&MOD(INT(INT(Proctor!B39/100)/1000000),10),\"\")&IF(Proctor!B39>=100000000,\",\"&MOD(INT(INT(Proctor!B39/100)/100000),10)&MOD(INT(INT(Proctor!B39/100)/10000),10)&MOD(INT(INT(Proctor!B39/100)/1000),10),\"\")&\",\"&MOD(INT(INT(Proctor!B39/100)/100),10)&MOD(INT(INT(Proctor!B39/100)/10),10)&MOD(INT(Proctor!B39/100),10))&\".\"&IF(MOD(Proctor!B39,100)<10,\"0\",\"\")&MOD(Proctor!B39,100)")
(formula "Certificate" "B9" "=IF(Proctor!$B$40=0,\"asked last\",Firms!$D$3)")
(cell "Certificate" "A11" "[ Open for business ]")
(cell "Certificate" "B11" "or press O")
