(cell "Orders" "A26" "filled, in shares")
(cell "Orders" "A27" "the outcome: 1 filled, 2 closed, 3 no stock, 4 cash, 5 shares")
(formula "Orders" "B11" "=SUM(D6:I6)*B6+SUM(D7:I7)*B7+SUM(D8:I8)*B8+SUM(D9:I9)*B9")
(formula "Orders" "B12" "=SUM(D6:D9)+2*SUM(E6:E9)+3*SUM(F6:F9)+4*SUM(G6:G9)+5*SUM(H6:H9)+6*SUM(I6:I9)")
(formula "Orders" "B13" "=Input!$B$20")
(formula "Orders" "B14" "=IF(B13=Commands!$A$2,1,IF(B13=Commands!$A$3,2,IF(B13=Commands!$A$4,3,IF(B13=Commands!$A$5,4,0))))")
(formula "Orders" "B15" "=IF(B13=Commands!$A$6,1,IF(B13=Commands!$A$7,2,IF(B13=Commands!$A$8,3,IF(B13=Commands!$A$9,4,IF(B13=Commands!$A$10,5,IF(B13=Commands!$A$11,6,0))))))")
(formula "Orders" "B16" "=IF(B11+B14>0,IF(B11>0,B11,B14),Orders.last!B16)")
(formula "Orders" "B17" "=IF(B16=0,\"the stock picked, none yet\",CHOOSE(B16,A6,A7,A8,A9))")
(formula "Orders" "B18" "=IF(B20=0,\"\",CHOOSE(B20,A6,A7,A8,A9))")
(formula "Orders" "B19" "=IF($B$1=2,2,1)")
(formula "Orders" "B20" "=IF(B12>0,B11,IF(B15>0,Orders.last!B16,0))")
(formula "Orders" "B21" "=IF(B12>0,B12,B15)")
(formula "Orders" "B22" "=Day.last!$B$19")
(formula "Orders" "B23" "=IF(B20=0,0,CHOOSE(B20,Stocks.last!$E$5,Stocks.last!$E$6,Stocks.last!$E$7,Stocks.last!$E$8))")
(formula "Orders" "B24" "=IF(B19=2,Cash.last!$B$4,Cash.last!$B$3)")
(formula "Orders" "B25" "=IF(B20=0,0,CHOOSE(B20+4*(B19-1),Positions.last!$E$2,Positions.last!$E$3,Positions.last!$E$4,Positions.last!$E$5,Positions.last!$E$6,Positions.last!$E$7,Positions.last!$E$8,Positions.last!$E$9))")
(formula "Orders" "B26" "=IF(OR(B21=0,B22<>1,B20=0),0,CHOOSE(B21,IF(B23<=B24,1,0),IF(10*B23<=B24,10,0),INT(B24/B23),IF(B25>=1,-1,0),IF(B25>=10,-10,0),0-B25))")
(formula "Orders" "B27" "=IF(B21=0,0,IF(B22<>1,2,IF(B20=0,3,IF(B26<>0,1,IF(B21<=3,4,5)))))")
(cell "Orders" "A29" "orders filled")
(cell "Orders" "A30" "the ledger's row")
(cell "Orders" "A31" "the pocket's cash now, in cents")
(formula "Orders" "B29" "=Orders.last!B29+IF(B26<>0,1,0)")
(formula "Orders" "B30" "=MOD(B29-1,100)+2")
(formula "Orders" "B31" "=IF(B19=2,Cash!$B$4,Cash!$B$3)")
(cell "Orders" "A32" "the last order: its stock, by name")
(cell "Orders" "A33" "its pocket")
(cell "Orders" "A34" "its stock")
(cell "Orders" "A35" "its act")
(cell "Orders" "A36" "the market shown open")
(cell "Orders" "A37" "the price shown, in cents")
(cell "Orders" "A38" "the cash shown, in cents")
(cell "Orders" "A39" "the shares shown")
(cell "Orders" "A40" "filled, in shares")
(cell "Orders" "A41" "the outcome")
(formula "Orders" "B32:B41" "=IF($B$21>0,B18,Orders.last!B32)")
(column "Positions" "A" 8 shown none)
(column "Positions" "C" 10 shown none)
(cell "Positions" "A1" "pocket")
(cell "Positions" "B1" "rung")
(cell "Positions" "C1" "stock")
