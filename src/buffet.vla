(formula "Portfolio" "A2" "=IF(Day!$B$19=1,\"The market is open until 16:00.\",IF(Day!$B$25=1,\"The market opens when you leave the exam room.\",IF(AND(Day!$B$17<Day!$B$12,Day!$B$20<Day!$B$3),\"The market opens at 9:30.\",IF(AND(Day!$B$17<Day!$B$12-1,Day!$B$20=Day!$B$3),\"The market has closed. Analysts are analyzing the aftermath.\",\"The market is closed until Monday at 9:30.\"))))")
