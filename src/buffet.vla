; Expanded by the pass from buffet.source.vla: edit that file, then expand it again.
(cartridge "buffet"
  (spec 3)
  (title "Buffet")
  (rate 30)
  (screen grid 80 50)
  (seed 777)
  (author "Spreadsheet Company")
  (license "AGPL-3.0-or-later AND CC-BY-SA-4.0")
  (notes "Buffet: all you can sheet. The kitchen is open and the dining room is not: so far the market's calendar, a market day a second, and its dice, rolled once a day where anyone can watch them roll. Pick the Day or the Dice sheet to watch."))
(sheet "Screen" visible)
(sheet "Day" visible)
(sheet "Dice" visible)
(cell "Day" "A1" "frames a day")
(cell "Day" "A2" "days a year")
(cell "Day" "A3" "day")
(cell "Day" "A4" "phase")
(cell "Day" "A5" "boundary")
(cell "Day" "A6" "year")
(cell "Day" "A7" "day of the year")
(cell "Day" "B1" 30)
(cell "Day" "B2" 365)
(formula "Day" "B3" "=INT((Clock!B1-1)/B1)")
(formula "Day" "B4" "=MOD(Clock!B1-1,B1)")
(formula "Day" "B5" "=IF(B4=0,1,0)")
(formula "Day" "B6" "=INT(B3/B2)+1")
(formula "Day" "B7" "=MOD(B3,B2)+1")
(cell "Dice" "A1" "the market's die")
(cell "Dice" "A2" "draw 1")
(cell "Dice" "A3" "draw 2")
(cell "Dice" "A4" "draw 3")
(cell "Dice" "A5" "draw 4")
(cell "Dice" "C1" "uniform")
(formula "Dice" "B1" "=IF(Day!$B$5=1,MOD(IF(Day!$B$3=0,Clock!$B$3,Dice.last!B1)*$F$2,2147483647),Dice.last!B1)")
(formula "Dice" "B2:B5" "=MOD(B1*16807,2147483647)")
(formula "Dice" "C2:C5" "=B2/2147483647")
(cell "Dice" "A7" "the exam's die")
(cell "Dice" "A8" "draw 1")
(cell "Dice" "A9" "draw 2")
(cell "Dice" "C7" "uniform")
(formula "Dice" "B7" "=MOD(Clock!$B$3*$F$4,2147483647)")
(formula "Dice" "B8:B9" "=MOD(B7*16807,2147483647)")
(formula "Dice" "C8:C9" "=B8/2147483647")
(cell "Dice" "E1" "a day's jump, in draws")
(cell "Dice" "E2" "its multiplier")
(cell "Dice" "E3" "the exam's jump, in draws")
(cell "Dice" "E4" "its multiplier")
(cell "Dice" "F1" 1017)
(cell "Dice" "F2" 86383)
(cell "Dice" "F3" 1073741912)
(cell "Dice" "F4" 1164196)
