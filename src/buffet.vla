(formula "Cash" "B6" "=SUM(Positions!$K$2:$K$5)")
(formula "Cash" "B7" "=SUM(Positions!$K$6:$K$9)")
(cell "Cash" "A9" "the firm's net worth, in cents")
(cell "Cash" "A10" "personal net worth, in cents")
(formula "Cash" "B9" "=B3+B6")
(formula "Cash" "B10" "=B4+B7")
