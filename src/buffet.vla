(cell "Positions" "M1" "realized gain, in cents")
(cell "Positions" "A2:A5" 1)
(cell "Positions" "A6:A9" 2)
(cell "Positions" "B2" 1)
(cell "Positions" "B3" 2)
(cell "Positions" "B4" 3)
(cell "Positions" "B5" 4)
(cell "Positions" "B6" 1)
(cell "Positions" "B7" 2)
(cell "Positions" "B8" 3)
(cell "Positions" "B9" 4)
(formula "Positions" "C2:C9" "=CHOOSE(B2,Stocks!$A$5,Stocks!$A$6,Stocks!$A$7,Stocks!$A$8)")
(formula "Positions" "D2:D9" "=IF(AND(Orders!$B$19=A2,Orders!$B$20=B2),Orders!$B$26,0)")
(formula "Positions" "E2:E9" "=Positions.last!E2+D2")
(formula "Positions" "F2:F9" "=Positions.last!F2+IF(D2>0,D2*Orders!$B$23,IF(D2<0,0-IF(D2+Positions.last!E2=0,Positions.last!F2,INT((0-D2)*Positions.last!F2/Positions.last!E2+0.5)),0))")
(formula "Positions" "G2:G9" "=Positions.last!G2+IF(D2>0,D2*Orders!$B$23,0)")
(formula "Positions" "H2:H9" "=Positions.last!H2+IF(D2<0,(0-D2)*Orders!$B$23,0)")
(formula "Positions" "I2:I9" "=Positions.last!I2+IF(Day!$B$5=1,Positions.last!E2*CHOOSE(B2,Stocks!$H$5,Stocks!$H$6,Stocks!$H$7,Stocks!$H$8),0)")
(formula "Positions" "J2:J9" "=CHOOSE(B2,Stocks!$E$5,Stocks!$E$6,Stocks!$E$7,Stocks!$E$8)")
(formula "Positions" "K2:K9" "=E2*J2")
(formula "Positions" "L2:L9" "=K2-F2")
(formula "Positions" "M2:M9" "=H2-G2+F2")
