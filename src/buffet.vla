(cell "Remarks" "C3" "shown")
(cell "Remarks" "A2" "Well ahead of the market. The proctor has referred your file to Compliance, as a formality.")
(cell "Remarks" "A3" "Ahead of the market. The proctor notes that legends and cautionary tales both start this way.")
(cell "Remarks" "A4" "In line with the market, which Average Co. also managed, unattended.")
(cell "Remarks" "A5" "Behind the market. The proctor reminds you that Average Co. was available the whole time.")
(cell "Remarks" "A6" "Well behind the market. The proctor has left a pamphlet on index funds in your tray.")
(cell "Remarks" "D1" 5)
(formula "Remarks" "D3" "=CHOOSE(D2,A2,A3,A4,A5,A6)")
(formula "Remarks" "D2" "=Performance!$B$22")
(sheet "Errors" hidden)
(column "Errors" "A" 8 shown none)
(column "Errors" "B" 112 shown none)
(cell "Errors" "A1" "Error")
(cell "Errors" "B1" "Joke")
(cell "Errors" "D1" "rows")
(cell "Errors" "D2" "the row shown")
(cell "Errors" "D3" "shown")
(cell "Errors" "D4" "Joke")
(cell "Errors" "A2" "#NUM!")
(cell "Errors" "B2" "Net worth exceeds the present value of the known universe. Please purchase another universe to continue playing.")
(cell "Errors" "A3" "#DIV/0!")
(cell "Errors" "B3" "Return on zero capital: infinite, and unavailable.")
(cell "Errors" "A4" "#REF!")
(cell "Errors" "B4" "You no longer hold this position. It holds you.")
(cell "Errors" "A5" "#VALUE!")
(cell "Errors" "B5" "The analyst entered text where a number goes. The analyst is on a call.")
(cell "Errors" "A6" "#N/A")
(cell "Errors" "B6" "Data not available. The data is OOO.")
(cell "Errors" "E1" 5)
