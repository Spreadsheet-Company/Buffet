(cell "Cash" "A4" "personal cash, in cents")
(formula "Cash" "B3" "=Proctor!$B$39-SUM(Positions!$G$2:$G$5)+SUM(Positions!$H$2:$H$5)+SUM(Positions!$I$2:$I$5)")
(formula "Cash" "B4" "=$B$1+Hustle!$B$18-SUM(Positions!$G$6:$G$9)+SUM(Positions!$H$6:$H$9)+SUM(Positions!$I$6:$I$9)")
(cell "Cash" "A6" "the firm's holdings, in cents")
(cell "Cash" "A7" "personal holdings, in cents")
(formula "Cash" "B6" "=SUM(Positions!$K$2:$K$5)")
(formula "Cash" "B7" "=SUM(Positions!$K$6:$K$9)")
(cell "Cash" "A9" "the firm's net worth, in cents")
(cell "Cash" "A10" "personal net worth, in cents")
(formula "Cash" "B9" "=B3+B6")
(formula "Cash" "B10" "=B4+B7")
