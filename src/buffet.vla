(formula "Market" "B14" "=Day!$B$3")
(formula "Market" "C14" "=B14-$B$4")
(formula "Market" "D14" "=B14-1")
(formula "Market" "B15:D19" "=$C7*SIN($D7*B$14+$E7)")
(formula "Market" "B20:D20" "=$B$2^B14")
(formula "Market" "B21:D21" "=1+B16+B17+B18+B19")
(formula "Market" "B22" "=1+C8*SIN(E8)+C9*SIN(E9)+C10*SIN(E10)+C11*SIN(E11)")
(formula "Market" "B23:D23" "=B20*(1+B15)")
(formula "Market" "B24:D24" "=B20*B21/$B$22")
(formula "Market" "B25:D25" "=CHOOSE($B$3+1,B23,B24)")
