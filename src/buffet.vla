(formula "Portfolio" "A5:A8" "=Stocks!A5")
(formula "Portfolio" "B5:B8" "=IF(Stocks!E5<1000,\"              \",IF(Stocks!E5<10000,\"            \",IF(Stocks!E5<100000,\"          \",IF(Stocks!E5<1000000,\"       \",IF(Stocks!E5<10000000,\"     \",IF(Stocks!E5<100000000,\"   \",\"\"))))))&IF(Stocks!E5<100000,INT(Stocks!E5/100),IF(Stocks!E5<100000000,INT(Stocks!E5/100000),IF(Stocks!E5<100000000000,INT(Stocks!E5/100000000),IF(Stocks!E5<100000000000000,INT(Stocks!E5/100000000000),INT(Stocks!E5/100000000000000))))&IF(Stocks!E5>=100000000000000,\",\"&MOD(INT(INT(Stocks!E5/100)/100000000000),10)&MOD(INT(INT(Stocks!E5/100)/10000000000),10)&MOD(INT(INT(Stocks!E5/100)/1000000000),10),\"\")&IF(Stocks!E5>=100000000000,\",\"&MOD(INT(INT(Stocks!E5/100)/100000000),10)&MOD(INT(INT(Stocks!E5/100)/10000000),10)&MOD(INT(INT(Stocks!E5/100)/1000000),10),\"\")&IF(Stocks!E5>=100000000,\",\"&MOD(INT(INT(Stocks!E5/100)/100000),10)&MOD(INT(INT(Stocks!E5/100)/10000),10)&MOD(INT(INT(Stocks!E5/100)/1000),10),\"\")&\",\"&MOD(INT(INT(Stocks!E5/100)/100),10)&MOD(INT(INT(Stocks!E5/100)/10),10)&MOD(INT(Stocks!E5/100),10))&\".\"&IF(MOD(Stocks!E5,100)<10,\"0\",\"\")&MOD(Stocks!E5,100)")
(formula "Portfolio" "C5:C8" "=IF(ABS(Stocks!I5)<1000,\"            \",IF(ABS(Stocks!I5)<10000,\"          \",IF(ABS(Stocks!I5)<100000,\"        \",IF(ABS(Stocks!I5)<1000000,\"     \",IF(ABS(Stocks!I5)<10000000,\"   \",IF(ABS(Stocks!I5)<100000000,\" \",\"\"))))))&IF(Stocks!I5<0,\" -\",\"+\")&IF(ABS(Stocks!I5)<100000,INT(ABS(Stocks!I5)/100),IF(ABS(Stocks!I5)<100000000,INT(ABS(Stocks!I5)/100000),IF(ABS(Stocks!I5)<100000000000,INT(ABS(Stocks!I5)/100000000),IF(ABS(Stocks!I5)<100000000000000,INT(ABS(Stocks!I5)/100000000000),INT(ABS(Stocks!I5)/100000000000000))))&IF(ABS(Stocks!I5)>=100000000000000,\",\"&MOD(INT(INT(ABS(Stocks!I5)/100)/100000000000),10)&MOD(INT(INT(ABS(Stocks!I5)/100)/10000000000),10)&MOD(INT(INT(ABS(Stocks!I5)/100)/1000000000),10),\"\")&IF(ABS(Stocks!I5)>=100000000000,\",\"&MOD(INT(INT(ABS(Stocks!I5)/100)/100000000),10)&MOD(INT(INT(ABS(Stocks!I5)/100)/10000000),10)&MOD(INT(INT(ABS(Stocks!I5)/100)/1000000),10),\"\")&IF(ABS(Stocks!I5)>=100000000,\",\"&MOD(INT(INT(ABS(Stocks!I5)/100)/100000),10)&MOD(INT(INT(ABS(Stocks!I5)/100)/10000),10)&MOD(INT(INT(ABS(Stocks!I5)/100)/1000),10),\"\")&\",\"&MOD(INT(INT(ABS(Stocks!I5)/100)/100),10)&MOD(INT(INT(ABS(Stocks!I5)/100)/10),10)&MOD(INT(ABS(Stocks!I5)/100),10))&\".\"&IF(MOD(ABS(Stocks!I5),100)<10,\"0\",\"\")&MOD(ABS(Stocks!I5),100)")
(formula "Portfolio" "D5:D8" "=IF(Stocks!I5>0,\"▲\",IF(Stocks!I5<0,\"▼\",\"=\"))")
