(formula "Orders" "D6:I9" "=IF(AND(Input!$B$19=$B$2,Input!$B$11=D$5,Input!$B$12=$C6,Input!$B$13=1,Input.last!$B$13=0),1,0)")
(cell "Orders" "A11" "the stock clicked")
(cell "Orders" "A12" "the act clicked")
(cell "Orders" "A13" "the command run")
(cell "Orders" "A14" "the stock a command picks")
(cell "Orders" "A15" "the act a command orders")
(cell "Orders" "A16" "the stock picked")
(cell "Orders" "A17" "the stock picked, by name")
(cell "Orders" "A18" "the order's stock, by name")
(cell "Orders" "A19" "the order's pocket")
(cell "Orders" "A20" "the order's stock")
(cell "Orders" "A21" "the order's act")
(cell "Orders" "A22" "the market shown open")
(cell "Orders" "A23" "the price shown, in cents")
(cell "Orders" "A24" "the cash shown, in cents")
